SECRET_KEY=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=8

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=noreply@digikul.in

# REST + Socket.IO share this list. In production add your public origin,
# e.g. https://digikul.example.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Live-session store + Socket.IO cross-worker broadcast.
# docker-compose overrides this to redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

UPLOAD_FOLDER=uploads
COMPRESSED_FOLDER=compressed
RECORDING_DIRECTORY=recordings

ENABLE_RECORDING=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_QUIZ_ANALYTICS=true
ENABLE_COHORT_SCOPING=true
