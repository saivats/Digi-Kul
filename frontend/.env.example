# ---------------------------------------------------------------------------
# Digi-Kul frontend — public build-time config
#
# All NEXT_PUBLIC_* values are baked into the JS bundle at `next build`.
# Change them => rebuild the frontend image.
#
# PRODUCTION: NEXT_PUBLIC_API_URL and NEXT_PUBLIC_SOCKET_URL must be the
# PUBLIC, nginx-fronted origin your users type into their browser
# (e.g. https://digikul.example.com). NOT http://localhost:8000 — that is
# the *student's own device* from the browser's point of view. nginx.conf
# proxies /api/ and /socket.io/ from that one origin to the backend, so the
# two values are normally identical.
# ---------------------------------------------------------------------------

# Local dev (backend on :8000, no nginx):
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SOCKET_URL=http://localhost:8000

# Production example (both = site origin):
# NEXT_PUBLIC_API_URL=https://digikul.example.com
# NEXT_PUBLIC_SOCKET_URL=https://digikul.example.com

# TURN relay for WebRTC audio (strongly recommended — mobile-data students
# behind carrier NAT will get no audio with STUN only). Provision e.g. coturn;
# see README section "TURN server".
# NEXT_PUBLIC_TURN_URL=turn:turn.example.com:3478,turns:turn.example.com:5349
# NEXT_PUBLIC_TURN_USERNAME=digikul
# NEXT_PUBLIC_TURN_CREDENTIAL=change-me
